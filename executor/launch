#!/usr/bin/env bash
set -euo pipefail
umask 077
[[ $# == 8 && $7 == --bundle-sha256 && $8 =~ ^[a-f0-9]{64}$ ]] || exit 2
actual=$(sha256sum /opt/provenance.sha256); [[ ${actual%% *} == "$8" ]] || exit 2
(cd /opt && sha256sum --strict -c provenance.sha256 >/dev/null)
export HOME=/tmp/home ANSIBLE_LOCAL_TEMP=/tmp/ansible-local ANSIBLE_REMOTE_TEMP=/tmp/ansible-remote PYTHONDONTWRITEBYTECODE=1 GIT_OPTIONAL_LOCKS=0
mkdir -p /tmp/home
source /home/python/python-env/bin/activate
exec python3 /opt/perkforge/bin/run-phase.py "${@:1:6}"
