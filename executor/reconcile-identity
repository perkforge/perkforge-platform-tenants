#!/usr/bin/env bash
# Source-only ABI; requires reviewed embedded-stage.yaml before any image can build/run.
set -euo pipefail
umask 077
context= enrollment= platform= invocation= inputs= expected= credentials= receipts=
while (($#)); do
  (($# >= 2)) || exit 2
  case "$1" in
    --context) context=$2;; --enrollment-revision) enrollment=$2;;
    --platform-revision) platform=$2;; --invocation) invocation=$2;;
    --inputs) inputs=$2;; --inputs-sha256) expected=$2;;
    --credentials) credentials=$2;; --receipts) receipts=$2;; *) exit 2;;
  esac
  shift 2
done
[[ $context =~ ^[a-z][a-z0-9-]{0,30}$ && $enrollment =~ ^[0-9a-f]{40}$ && $platform =~ ^[0-9a-f]{40}$ && $invocation =~ ^[0-9a-f]{64}$ && $expected =~ ^[0-9a-f]{64}$ ]] || exit 2
[[ $inputs == /inputs/inputs.yaml && $credentials == /credentials && $receipts == /receipts ]] || exit 2
# Verify all embedded executable source before touching credentials.
(cd /opt && sha256sum --strict -c provenance.sha256 >/dev/null)
python3 /opt/enrollment/executor/verify-runtime.py "$enrollment" "$platform" "$context" "$expected"
# The verifier checks projected roots; copy fixed files into a private regular-file tree.
work=$(mktemp -d /tmp/identity.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT
install -m 0600 /inputs/inputs.yaml "$work/inputs.yaml"
[[ $(sha256sum "$work/inputs.yaml" | cut -d' ' -f1) == "$expected" ]] || exit 2
install -m 0600 /credentials/group-writer "$work/token"
install -m 0600 /credentials/ca.crt "$work/ca.crt"
# Stable context directory/lock, NEVER invocation-specific lock.
python3 /opt/enrollment/executor/verify-runtime.py --receipt "$context"
exec 9>"/receipts/$context/trigger.lock"
flock -n 9 || exit 75
# No user names, tokens, raw provider responses or Ansible logs go to Pod stdout.
if ansible-playbook -i localhost, /opt/enrollment/executor/embedded-stage.yaml \
  -e "@$work/inputs.yaml" -e "executor_context=$context" \
  -e "executor_enrollment_revision=$enrollment" -e "executor_platform_revision=$platform" \
  -e "executor_token_file=$work/token" -e "executor_ca_file=$work/ca.crt" \
  -e "executor_receipt_file=/receipts/$context/group.json" >"$work/run.log" 2>&1; then
  printf '%s\n' 'GroupReady; PendingIdentity. No complete onboarding claim.'
else
  printf '%s\n' 'GroupFoundationFailed; private receipt retained. No automatic replay.' >&2
  exit 1
fi
