#!/usr/bin/env python3
"""Refresh only the fixed issuer projection; never fetch, authenticate or log bodies."""
import importlib.util,os,stat,sys,tempfile
from pathlib import Path
CONTRACT='/opt/platform/big-bang-bootstrap/configuration/packages/gitlab/enrollment/phases/contract.py'
PROJECTION=Path('/identity-evidence')
def refresh(inputs,work):
 w=Path(work)
 if str(w)!=work or inputs!=work+'/phase-inputs.json':raise ValueError('fixed paths')
 s=w.lstat()
 if not stat.S_ISDIR(s.st_mode) or s.st_uid!=os.getuid() or stat.S_IMODE(s.st_mode)!=0o700:raise ValueError('private work')
 sys.path.insert(0,str(Path(CONTRACT).parent))
 spec=importlib.util.spec_from_file_location('phase_contract',CONTRACT);contract=importlib.util.module_from_spec(spec);spec.loader.exec_module(contract)
 d=contract.inputs(inputs,'memberships')
 if PROJECTION.is_symlink() or not PROJECTION.is_dir():raise ValueError('projection root')
 p=(PROJECTION/'receipt.json').resolve(strict=True)
 if not p.is_relative_to(PROJECTION) or p==PROJECTION:raise ValueError('projection escape')
 fd=os.open(p,os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW)
 try:
  s=os.fstat(fd)
  if not stat.S_ISREG(s.st_mode) or s.st_size>262144:raise ValueError('projection file')
  with os.fdopen(fd,'rb',closefd=False) as f:raw=f.read(262145)
 finally:os.close(fd)
 if len(raw)>262144:raise ValueError('projection size')
 fd,tmp=tempfile.mkstemp(prefix='.envelope-',dir=w)
 try:
  os.fchmod(fd,0o600)
  with os.fdopen(fd,'wb') as f:f.write(raw);f.flush();os.fsync(f.fileno())
  contract.envelope(d,tmp)
  target=w/'envelope.json'
  if os.path.lexists(target):
   s=target.lstat()
   if not stat.S_ISREG(s.st_mode) or s.st_uid!=os.getuid() or stat.S_IMODE(s.st_mode)!=0o600 or s.st_nlink!=1:raise ValueError('existing envelope')
  os.replace(tmp,target)
 finally:
  if os.path.exists(tmp):os.unlink(tmp)
if __name__=='__main__':
 try:
  if len(sys.argv)!=3:raise ValueError('arguments')
  refresh(*sys.argv[1:])
 except Exception:raise SystemExit('Issuer evidence rejected; no writer operation permitted.')
