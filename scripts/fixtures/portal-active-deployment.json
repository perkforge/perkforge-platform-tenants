{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "portal",
    "namespace": "tenant-portal",
    "labels": {
      "app.kubernetes.io/name": "perkforge-portal"
    }
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "perkforge-portal"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "perkforge-portal"
        },
        "annotations": {
          "checksum/enrollment-inventory": "9513d136ddfd037698110772af48210e7a19c63bc8944281e6d75b6f644c650f"
        }
      },
      "spec": {
        "serviceAccountName": "portal-runtime",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "storage.perkforge.io/worker": "true"
        },
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "node-role.kubernetes.io/control-plane",
                      "operator": "DoesNotExist"
                    },
                    {
                      "key": "node-role.kubernetes.io/master",
                      "operator": "DoesNotExist"
                    }
                  ]
                }
              ]
            }
          }
        },
        "imagePullSecrets": [
          {
            "name": "portal-registry-existing"
          }
        ],
        "volumes": [
          {
            "name": "enrollment-inventory",
            "configMap": {
              "name": "portal-enrollment-inventory"
            }
          },
          {
            "name": "identity-ca",
            "configMap": {
              "name": "portal-identity-ca",
              "items": [
                {
                  "key": "ca.crt",
                  "path": "ca.crt"
                }
              ]
            }
          }
        ],
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "portal",
            "image": "ghcr.io/perkforge/perkforge-portal@sha256:eaa66ab13be20079f188f4b5d8c5d79e274612f0f5742a8d3c0d2f0f6a48560d",
            "imagePullPolicy": "IfNotPresent",
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "ports": [
              {
                "name": "http",
                "containerPort": 3000
              }
            ],
            "volumeMounts": [
              {
                "name": "enrollment-inventory",
                "mountPath": "/etc/portal/enrollment",
                "readOnly": true
              },
              {
                "name": "identity-ca",
                "mountPath": "/etc/portal/identity-ca",
                "readOnly": true
              }
            ],
            "env": [
              {
                "name": "ENROLLMENT_SOURCE",
                "value": "gitops-configmap"
              },
              {
                "name": "ENROLLMENT_SOURCE_COMMIT",
                "value": "49839241472c17e73b0562d43983d07347b26f58"
              },
              {
                "name": "ENROLLMENT_SELECTOR",
                "value": "local-nextcloud-portal"
              },
              {
                "name": "ENROLLMENT_INVENTORY_SHA256",
                "value": "9513d136ddfd037698110772af48210e7a19c63bc8944281e6d75b6f644c650f"
              },
              {
                "name": "NODE_EXTRA_CA_CERTS",
                "value": "/etc/portal/identity-ca/ca.crt"
              },
              {
                "name": "LISTEN_HOST",
                "value": "0.0.0.0"
              },
              {
                "name": "PORTAL_ORIGIN",
                "value": "https://portal.perkforge.home.arpa"
              },
              {
                "name": "TENANT_SOURCE",
                "value": "disabled"
              },
              {
                "name": "PORTAL_ACCESS_POLICY",
                "value": "platform-admins"
              },
              {
                "name": "OIDC_ISSUER",
                "value": "https://keycloak.perkforge.home.arpa/auth/realms/perkforge"
              },
              {
                "name": "OIDC_CLIENT_ID",
                "value": "portal-local"
              },
              {
                "name": "OIDC_AUDIENCE",
                "value": "portal-local"
              },
              {
                "name": "OIDC_CLIENT_SECRET",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "portal-oidc-existing",
                    "key": "client-secret"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "250m",
                "memory": "192Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "http"
              },
              "periodSeconds": 10
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "http"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 20
            }
          }
        ]
      }
    }
  }
}
